POSTGRES_DB=texas_holdem
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
# Prisma runtime/migration connection URL. Keep it aligned with the local PostgreSQL values above.
DATABASE_URL=postgresql://postgres:change-me-for-local-development@127.0.0.1:5432/texas_holdem?schema=public
SERVER_PORT=3001
# Comma-separated browser origins permitted to use the Socket.IO server; no paths or trailing slashes.
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# In a same-origin Vercel Services deployment, set these to route HTTP and
# Socket.IO through the single public site URL instead of a second domain.
# NEXT_PUBLIC_SERVER_URL=/server
# SERVICE_BASE_PATH=/server
# SOCKET_IO_PATH=/server/socket.io
# Required server-only HMAC key for private durable hand snapshots. Generate a fresh
# value locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PRIVATE_SNAPSHOT_KEY_ID=local-2026-01
PRIVATE_SNAPSHOT_KEY_BASE64=

# On Vercel with Supabase, use the Supavisor Transaction Pooler connection
# (port 6543) rather than the Session Pooler. Prisma's runtime pool is capped
# to one connection in apps/server/src/persistence/prisma.ts.
