{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "crons": [{ "path": "/server/internal/coach/run", "schedule": "10 2 * * *" }],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "game": {
      "root": "apps/server",
      "entrypoint": "src/index.ts",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/server/(.*)",
      "destination": { "service": "game" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
