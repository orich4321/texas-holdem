generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoomStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Room {
  id                  String              @id @default(uuid()) @db.Uuid
  joinId              String              @unique
  status              RoomStatus          @default(WAITING)
  initialStack        Int                 @default(500)
  smallBlind          Int                 @default(1)
  bigBlind            Int                 @default(2)
  maxPlayers          Int                 @default(9)
  nextHandIsFinal     Boolean             @default(false)
  finalSummaryVisible Boolean             @default(true)
  turnDeadlineAt      DateTime?
  hostPlayerId        String?             @db.Uuid
  hostPlayer          Player?             @relation("RoomHost", fields: [id, hostPlayerId], references: [roomId, id], onDelete: Restrict)
  players             Player[]            @relation("RoomPlayers")
  events              GameEvent[]
  snapshots           GameSnapshot[]
  settlements         Settlement[]
  chipAdjustments     ChipAdjustment[]
  preActions          PreAction[]
  gameInvites         GameInvite[]
  hiddenForAccounts   AccountHiddenGame[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status])
}

model Player {
  id                        String           @id @db.Uuid
  roomId                    String           @db.Uuid
  accountId                 String?          @db.Uuid
  displayName               String
  avatarDataUrl             String?
  initialStack              Int
  currentStack              Int
  accessTokenHash           String           @unique
  leftAt                    DateTime?
  leaveAfterHand            Boolean          @default(false)
  isSittingOut              Boolean          @default(false)
  rebuyDecisionPending      Boolean          @default(false)
  timeCardsRemaining        Int              @default(3)
  room                      Room             @relation("RoomPlayers", fields: [roomId], references: [id], onDelete: Cascade)
  account                   Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  hostedRooms               Room[]           @relation("RoomHost")
  receivedChipAdjustments   ChipAdjustment[] @relation("ChipRecipient")
  authorizedChipAdjustments ChipAdjustment[] @relation("ChipAuthorizer")
  preAction                 PreAction?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@unique([roomId, id])
  @@unique([roomId, accountId])
  @@index([roomId])
  @@index([roomId, leftAt])
}

model Account {
  id                          String              @id @default(uuid()) @db.Uuid
  supabaseUserId              String              @unique @db.Uuid
  displayName                 String?
  avatarDataUrl               String?
  username                    String?             @unique
  directoryVisibleToAccountId String?             @db.Uuid
  sessions                    AccountSession[]
  players                     Player[]
  gamePresets                 GamePreset[]
  sentFriendRequests          FriendRequest[]     @relation("FriendRequestSender")
  receivedFriendRequests      FriendRequest[]     @relation("FriendRequestRecipient")
  friendshipsA                Friend[]            @relation("FriendA")
  friendshipsB                Friend[]            @relation("FriendB")
  sentGameInvites             GameInvite[]        @relation("GameInviteSender")
  receivedGameInvites         GameInvite[]        @relation("GameInviteRecipient")
  hiddenGames                 AccountHiddenGame[]
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  @@index([directoryVisibleToAccountId])
}

model FriendRequest {
  id            String   @id @default(uuid()) @db.Uuid
  fromAccountId String   @db.Uuid
  toAccountId   String   @db.Uuid
  fromAccount   Account  @relation("FriendRequestSender", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount     Account  @relation("FriendRequestRecipient", fields: [toAccountId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([fromAccountId, toAccountId])
  @@index([toAccountId])
}

model Friend {
  id         String   @id @default(uuid()) @db.Uuid
  accountAId String   @db.Uuid
  accountBId String   @db.Uuid
  accountA   Account  @relation("FriendA", fields: [accountAId], references: [id], onDelete: Cascade)
  accountB   Account  @relation("FriendB", fields: [accountBId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([accountAId, accountBId])
  @@index([accountBId])
}

model GameInvite {
  id            String   @id @default(uuid()) @db.Uuid
  roomId        String   @db.Uuid
  fromAccountId String   @db.Uuid
  toAccountId   String   @db.Uuid
  status        String   @default("PENDING")
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromAccount   Account  @relation("GameInviteSender", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount     Account  @relation("GameInviteRecipient", fields: [toAccountId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([roomId, toAccountId])
  @@index([toAccountId, status])
}

model GamePreset {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @db.Uuid
  name         String
  initialStack Int
  smallBlind   Int
  bigBlind     Int
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
}

// A personal archive preference. The room, hands, and every other player's
// history remain intact when an account hides one of its own games.
model AccountHiddenGame {
  accountId String   @db.Uuid
  roomId    String   @db.Uuid
  hiddenAt  DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([accountId, roomId])
  @@index([accountId])
}

model AccountSession {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

model GameEvent {
  id             String   @id @default(uuid()) @db.Uuid
  roomId         String   @db.Uuid
  sequence       Int
  type           String
  payload        Json
  clientActionId String?  @unique
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([roomId, sequence])
}

model PreAction {
  id                 String   @id @default(uuid()) @db.Uuid
  roomId             String   @db.Uuid
  playerId           String   @db.Uuid
  handStartSequence  Int
  street             String
  type               String
  expectedCurrentBet Int?
  quotedToCall       Int?
  createdAt          DateTime @default(now())
  room               Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player             Player   @relation(fields: [roomId, playerId], references: [roomId, id], onDelete: Cascade)

  @@unique([roomId, playerId])
  @@index([roomId])
}

model ChipAdjustment {
  id                   String    @id @default(uuid()) @db.Uuid
  roomId               String    @db.Uuid
  playerId             String    @db.Uuid
  authorizedByPlayerId String    @db.Uuid
  amount               Int
  status               String    @default("PENDING")
  stackBefore          Int?
  stackAfter           Int?
  createdAt            DateTime  @default(now())
  appliedAt            DateTime?
  cancelledAt          DateTime?
  room                 Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player               Player    @relation("ChipRecipient", fields: [playerId], references: [id], onDelete: Cascade)
  authorizedBy         Player    @relation("ChipAuthorizer", fields: [authorizedByPlayerId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
  @@index([playerId, status])
}

model GameSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  sequence  Int
  state     Json
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([roomId, sequence])
}

model Settlement {
  id             String   @id @default(uuid()) @db.Uuid
  roomId         String   @db.Uuid
  idempotencyKey String
  result         Json
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([roomId, idempotencyKey])
}
