{
  "name": "@texas-holdem/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --dir ../.. --filter @texas-holdem/poker-core build && prisma migrate deploy --schema prisma/schema.prisma && prisma generate --schema prisma/schema.prisma && tsc --noEmit",
    "dev": "tsx watch --conditions=development --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@texas-holdem/poker-core": "workspace:*",
    "@vercel/functions": "3.10.5",
    "express": "^4.21.2",
    "pg": "8.18.0",
    "socket.io": "^4.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/pg": "8.15.6",
    "prisma": "7.10.0",
    "tsx": "^4.19.2"
  }
}
